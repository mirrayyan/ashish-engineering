---
---

<!-- Quote modal -->
<div
	id="quote-modal"
	class="fixed inset-0 z-[100] hidden items-center justify-center overflow-y-auto p-4 sm:p-6 md:p-12"
	aria-hidden="true"
	role="dialog"
	aria-modal="true"
	aria-labelledby="quote-title"
>
	<!-- Backdrop -->
	<div
		data-quote-close
		data-quote-backdrop
		class="fixed inset-0 bg-black/70 opacity-0 backdrop-blur-sm transition-opacity duration-200 ease-out"
	></div>

	<!-- Panel: dark liquid glass -->
	<div
		data-quote-panel
		class="relative z-10 my-auto max-h-[90svh] w-full max-w-lg translate-y-6 overflow-y-auto rounded-2xl border border-white/10 bg-black/60 p-5 opacity-0 shadow-2xl backdrop-blur-xl transition-[opacity,transform] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] sm:rounded-3xl sm:p-8 md:p-10"
	>
		<button
			type="button"
			data-quote-close
			aria-label="Close"
			class="absolute right-4 top-4 flex h-8 w-8 items-center justify-center rounded-full border border-white/10 text-white/70 transition hover:bg-white/10 hover:text-white sm:right-5 sm:top-5 sm:h-9 sm:w-9"
		>
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4">
				<path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
			</svg>
		</button>

		<h2 id="quote-title" class="pr-10 text-2xl font-semibold tracking-tight text-white sm:text-3xl md:text-4xl">
			Contact Us
		</h2>
		<p class="mt-3 text-sm leading-snug text-white/70 sm:text-base">
			Tell us what you need and our team will get back to you with pricing.
		</p>

		<form data-quote-form class="mt-6 flex flex-col gap-3 sm:mt-8 sm:gap-4">
			<!-- Honeypot: hidden from real users, filled in by spam bots -->
			<input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" />
			<input type="hidden" name="_subject" value="New quote request — Ashish Engineering Works" />
			<input type="hidden" name="_captcha" value="false" />
			<input type="hidden" name="_template" value="table" />

			<div class="flex flex-col gap-2">
				<label for="q-name" class="text-sm font-medium text-white/80">Name</label>
				<input
					id="q-name"
					name="name"
					type="text"
					required
					placeholder="Your name"
					class="rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-base text-white placeholder-white/40 outline-none transition focus:border-white/40 focus:bg-white/10 sm:rounded-2xl sm:px-5 sm:py-3.5"
				/>
			</div>

			<div class="grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-4">
				<div class="flex flex-col gap-2">
					<label for="q-email" class="text-sm font-medium text-white/80">Email</label>
					<input
						id="q-email"
						name="email"
						type="email"
						required
						placeholder="you@company.com"
						class="rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-base text-white placeholder-white/40 outline-none transition focus:border-white/40 focus:bg-white/10 sm:rounded-2xl sm:px-5 sm:py-3.5"
					/>
				</div>
				<div class="flex flex-col gap-2">
					<label for="q-phone" class="text-sm font-medium text-white/80">Phone</label>
					<input
						id="q-phone"
						name="phone"
						type="tel"
						placeholder="+91 00000 00000"
						class="rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-base text-white placeholder-white/40 outline-none transition focus:border-white/40 focus:bg-white/10 sm:rounded-2xl sm:px-5 sm:py-3.5"
					/>
				</div>
			</div>

			<div class="flex flex-col gap-2">
				<label for="q-product" class="text-sm font-medium text-white/80">Product of interest</label>
				<input
					id="q-product"
					name="product"
					type="text"
					placeholder="e.g. Chinese Gas Range"
					class="rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-base text-white placeholder-white/40 outline-none transition focus:border-white/40 focus:bg-white/10 sm:rounded-2xl sm:px-5 sm:py-3.5"
				/>
			</div>

			<div class="flex flex-col gap-2">
				<label for="q-message" class="text-sm font-medium text-white/80">Message</label>
				<textarea
					id="q-message"
					name="message"
					rows="3"
					placeholder="Quantity, specifications, timeline…"
					class="resize-none rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-base text-white placeholder-white/40 outline-none transition focus:border-white/40 focus:bg-white/10 sm:rounded-2xl sm:px-5 sm:py-3.5"
				></textarea>
			</div>

			<p data-quote-error class="hidden text-sm text-red-400" role="alert"></p>

			<button
				type="submit"
				data-quote-submit
				class="mt-2 flex h-12 items-center justify-center gap-2 rounded-full bg-white/95 px-6 text-sm font-semibold text-black transition hover:bg-white disabled:cursor-not-allowed disabled:opacity-60"
			>
				<span data-quote-submit-label>Send Request</span>
				<svg data-quote-submit-icon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4">
					<path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
				<svg data-quote-submit-spinner class="hidden h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none">
					<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
					<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
				</svg>
			</button>
		</form>

		<!-- Success state, swapped in for the form -->
		<div data-quote-success class="hidden flex-col items-start gap-3 py-6">
			<div class="flex h-12 w-12 items-center justify-center rounded-full bg-white/10">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-6 w-6 text-white">
					<path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
			</div>
			<h3 class="text-xl font-semibold text-white">Request sent</h3>
			<p class="text-sm leading-relaxed text-white/70">
				Thanks — we've got your details and will get back to you shortly.
			</p>
			<button
				type="button"
				data-quote-close
				class="mt-2 flex h-11 items-center justify-center rounded-full border border-white/15 px-5 text-sm font-medium text-white/80 transition hover:bg-white/10 hover:text-white"
			>
				Close
			</button>
		</div>
	</div>
</div>

<script>
	const FORMSUBMIT_ENDPOINT = 'https://formsubmit.co/ajax/mohammadmuzain8@gmail.com';

	const modal = document.getElementById('quote-modal');
	const backdrop = modal?.querySelector<HTMLElement>('[data-quote-backdrop]');
	const panel = modal?.querySelector<HTMLElement>('[data-quote-panel]');
	const form = modal?.querySelector<HTMLFormElement>('[data-quote-form]');
	const success = modal?.querySelector<HTMLElement>('[data-quote-success]');
	const errorEl = modal?.querySelector<HTMLElement>('[data-quote-error]');
	const submitBtn = modal?.querySelector<HTMLButtonElement>('[data-quote-submit]');
	const submitLabel = modal?.querySelector<HTMLElement>('[data-quote-submit-label]');
	const submitIcon = modal?.querySelector<HTMLElement>('[data-quote-submit-icon]');
	const submitSpinner = modal?.querySelector<HTMLElement>('[data-quote-submit-spinner]');

	const ANIMATION_MS = 300;
	let closeTimeout: ReturnType<typeof setTimeout> | undefined;

	const resetForm = () => {
		form?.reset();
		form?.classList.remove('hidden');
		success?.classList.add('hidden');
		success?.classList.remove('flex');
		errorEl?.classList.add('hidden');
		if (errorEl) errorEl.textContent = '';
	};

	const setSubmitting = (submitting: boolean) => {
		if (submitBtn) submitBtn.disabled = submitting;
		submitIcon?.classList.toggle('hidden', submitting);
		submitSpinner?.classList.toggle('hidden', !submitting);
		if (submitLabel) submitLabel.textContent = submitting ? 'Sending…' : 'Send Request';
	};

	const open = (product?: string) => {
		if (product) {
			const productField = document.getElementById('q-product') as HTMLInputElement | null;
			if (productField) productField.value = product;
		}
		clearTimeout(closeTimeout);
		modal?.classList.remove('hidden');
		modal?.classList.add('flex');
		modal?.setAttribute('aria-hidden', 'false');
		document.body.style.overflow = 'hidden';

		// Force layout so the transition runs from opacity-0/scale-[0.98] instead of snapping in.
		requestAnimationFrame(() => {
			backdrop?.classList.remove('opacity-0');
			panel?.classList.remove('opacity-0', 'translate-y-6');
		});
	};

	const close = () => {
		backdrop?.classList.add('opacity-0');
		panel?.classList.add('opacity-0', 'translate-y-6');
		modal?.setAttribute('aria-hidden', 'true');
		document.body.style.overflow = '';

		closeTimeout = setTimeout(() => {
			modal?.classList.add('hidden');
			modal?.classList.remove('flex');
			resetForm();
			setSubmitting(false);
		}, ANIMATION_MS);
	};

	document.querySelectorAll<HTMLElement>('[data-quote-open]').forEach((el) => {
		el.addEventListener('click', (e) => {
			e.preventDefault();
			open(el.dataset.quoteProduct);
		});
	});

	modal?.querySelectorAll('[data-quote-close]').forEach((el) => {
		el.addEventListener('click', close);
	});

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && !modal?.classList.contains('hidden')) close();
	});

	form?.addEventListener('submit', async (e) => {
		e.preventDefault();

		const honey = (form.elements.namedItem('_honey') as HTMLInputElement | null)?.value;
		if (honey) return; // bot filled the honeypot — silently drop

		errorEl?.classList.add('hidden');
		setSubmitting(true);

		try {
			const res = await fetch(FORMSUBMIT_ENDPOINT, {
				method: 'POST',
				headers: { Accept: 'application/json' },
				body: new FormData(form),
			});

			if (!res.ok) throw new Error(`FormSubmit responded with ${res.status}`);

			form.classList.add('hidden');
			success?.classList.remove('hidden');
			success?.classList.add('flex');
		} catch (err) {
			if (errorEl) {
				errorEl.textContent = "Something went wrong sending your request — please try again, or email us directly.";
				errorEl.classList.remove('hidden');
			}
		} finally {
			setSubmitting(false);
		}
	});
</script>
