---
---

<!-- Quote modal -->
<div
	id="quote-modal"
	class="fixed inset-0 z-[100] hidden items-center justify-center px-6 py-10 md:px-12"
	aria-hidden="true"
	role="dialog"
	aria-modal="true"
	aria-labelledby="quote-title"
>
	<!-- Backdrop -->
	<div data-quote-close class="absolute inset-0 bg-black/70 backdrop-blur-sm"></div>

	<!-- Panel: dark liquid glass -->
	<div
		class="relative z-10 w-full max-w-lg overflow-hidden rounded-3xl border border-white/10 bg-black/60 p-8 shadow-2xl backdrop-blur-xl md:p-10"
	>
		<button
			type="button"
			data-quote-close
			aria-label="Close"
			class="absolute right-5 top-5 flex h-9 w-9 items-center justify-center rounded-full border border-white/10 text-white/70 transition hover:bg-white/10 hover:text-white"
		>
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4">
				<path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
			</svg>
		</button>

		<h2 id="quote-title" class="text-3xl font-semibold tracking-tight text-white md:text-4xl">
			Get a Quote
		</h2>
		<p class="mt-3 text-base leading-snug text-white/70">
			Tell us what you need and our team will get back to you with pricing.
		</p>

		<form class="mt-8 flex flex-col gap-4">
			<div class="flex flex-col gap-2">
				<label for="q-name" class="text-sm font-medium text-white/80">Name</label>
				<input
					id="q-name"
					name="name"
					type="text"
					required
					placeholder="Your name"
					class="rounded-2xl border border-white/10 bg-white/5 px-5 py-3.5 text-base text-white placeholder-white/40 outline-none transition focus:border-white/40 focus:bg-white/10"
				/>
			</div>

			<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
				<div class="flex flex-col gap-2">
					<label for="q-email" class="text-sm font-medium text-white/80">Email</label>
					<input
						id="q-email"
						name="email"
						type="email"
						required
						placeholder="you@company.com"
						class="rounded-2xl border border-white/10 bg-white/5 px-5 py-3.5 text-base text-white placeholder-white/40 outline-none transition focus:border-white/40 focus:bg-white/10"
					/>
				</div>
				<div class="flex flex-col gap-2">
					<label for="q-phone" class="text-sm font-medium text-white/80">Phone</label>
					<input
						id="q-phone"
						name="phone"
						type="tel"
						placeholder="+91 00000 00000"
						class="rounded-2xl border border-white/10 bg-white/5 px-5 py-3.5 text-base text-white placeholder-white/40 outline-none transition focus:border-white/40 focus:bg-white/10"
					/>
				</div>
			</div>

			<div class="flex flex-col gap-2">
				<label for="q-product" class="text-sm font-medium text-white/80">Product of interest</label>
				<input
					id="q-product"
					name="product"
					type="text"
					placeholder="e.g. Chinese Gas Range"
					class="rounded-2xl border border-white/10 bg-white/5 px-5 py-3.5 text-base text-white placeholder-white/40 outline-none transition focus:border-white/40 focus:bg-white/10"
				/>
			</div>

			<div class="flex flex-col gap-2">
				<label for="q-message" class="text-sm font-medium text-white/80">Message</label>
				<textarea
					id="q-message"
					name="message"
					rows="3"
					placeholder="Quantity, specifications, timeline…"
					class="resize-none rounded-2xl border border-white/10 bg-white/5 px-5 py-3.5 text-base text-white placeholder-white/40 outline-none transition focus:border-white/40 focus:bg-white/10"
				></textarea>
			</div>

			<button
				type="submit"
				class="mt-2 flex h-12 items-center justify-center gap-2 rounded-full bg-white/95 px-6 text-sm font-semibold text-black transition hover:bg-white"
			>
				Send Request
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4">
					<path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
			</button>
		</form>
	</div>
</div>

<script>
	const modal = document.getElementById('quote-modal');

	const open = () => {
		modal?.classList.remove('hidden');
		modal?.classList.add('flex');
		modal?.setAttribute('aria-hidden', 'false');
		document.body.style.overflow = 'hidden';
	};

	const close = () => {
		modal?.classList.add('hidden');
		modal?.classList.remove('flex');
		modal?.setAttribute('aria-hidden', 'true');
		document.body.style.overflow = '';
	};

	document.querySelectorAll('[data-quote-open]').forEach((el) => {
		el.addEventListener('click', (e) => {
			e.preventDefault();
			open();
		});
	});

	modal?.querySelectorAll('[data-quote-close]').forEach((el) => {
		el.addEventListener('click', close);
	});

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && !modal?.classList.contains('hidden')) close();
	});
</script>
