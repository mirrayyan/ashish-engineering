---
interface Props {
	name: 'phone' | 'whatsapp' | 'mail';
	class?: string;
}

const { name, class: className = 'h-4 w-4' } = Astro.props;
---

{
	name === 'phone' && (
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class:list={['shrink-0', className]} aria-hidden="true">
			<path
				d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"
				stroke-linecap="round"
				stroke-linejoin="round"
			/>
		</svg>
	)
}
{
	name === 'whatsapp' && (
		<svg viewBox="0 0 24 24" fill="currentColor" class:list={['shrink-0', className]} aria-hidden="true">
			<path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35Z" />
			<path d="M12.04 2C6.5 2 2 6.48 2 12c0 1.77.46 3.5 1.34 5.02L2 22l5.1-1.33A10.05 10.05 0 0 0 12.04 22C17.58 22 22 17.52 22 12S17.58 2 12.04 2Zm0 18.3c-1.5 0-2.97-.4-4.25-1.16l-.3-.18-3.03.79.81-2.95-.2-.3A8.25 8.25 0 0 1 3.78 12c0-4.56 3.7-8.27 8.26-8.27 4.55 0 8.2 3.7 8.2 8.27 0 4.56-3.65 8.3-8.2 8.3Z" />
		</svg>
	)
}
{
	name === 'mail' && (
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class:list={['shrink-0', className]} aria-hidden="true">
			<rect x="3" y="5" width="18" height="14" rx="2" />
			<path d="m3 7 9 6 9-6" stroke-linecap="round" stroke-linejoin="round" />
		</svg>
	)
}
