---

<section
	class="relative h-screen w-full overflow-hidden bg-cover bg-center bg-no-repeat"
	style="background-image: url('/hero-factory.webp');"
>
	<!-- Overlay for readability -->
	<div class="absolute inset-0 z-0 bg-gradient-to-t from-black/75 via-black/45 to-black/55"></div>

	<!-- Hero copy -->
	<div class="absolute inset-x-0 bottom-0 z-10 px-6 pb-16 md:px-12 md:pb-24">
		<div class="flex max-w-2xl flex-col items-start text-left">
			<h1 class="text-6xl font-semibold leading-[0.95] tracking-tight text-white sm:text-7xl md:text-8xl">
				Precision in<br />every process
			</h1>
			<p class="mt-8 max-w-md text-lg leading-snug text-white/90 md:text-xl">
				Delivering high-quality steel fabrication and industrial kitchen equipment.
			</p>
			<div class="mt-8 flex flex-wrap items-center gap-4">
				<a
					href="#"
					class="rounded-full bg-white px-7 py-3.5 text-base font-medium text-black transition hover:bg-white/90"
				>
					About Us
				</a>
				<a
					href="#"
					class="rounded-full border border-white/30 bg-white/5 px-7 py-3.5 text-base font-medium text-white backdrop-blur-sm transition hover:bg-white/15"
				>
					Explore Our Company
				</a>
			</div>
		</div>
	</div>
</section>
