---
---

<section
	class="relative h-screen w-full overflow-hidden bg-cover bg-center bg-no-repeat"
	style="background-image: url('/hero-factory.webp');"
	data-navbar-theme="dark"
	data-nav-section="home"
>
	<!-- Overlay for readability -->
	<div class="absolute inset-0 z-0 bg-gradient-to-t from-black/75 via-black/45 to-black/55"></div>

	<!-- Hero copy -->
	<div class="absolute inset-x-0 bottom-0 z-10 px-6 pb-16 md:px-12 md:pb-24">
		<div class="flex max-w-2xl flex-col items-start text-left">
			<h1 class="text-5xl font-semibold leading-[0.95] tracking-tight text-white sm:text-6xl md:text-7xl lg:text-8xl">
				Precision in<br />every process
			</h1>
			<p class="mt-8 max-w-md text-base leading-snug text-white/90 sm:text-lg md:text-xl">
				Delivering high-quality steel fabrication and industrial kitchen equipment.
			</p>
			<div class="mt-8 flex flex-wrap items-center gap-3 sm:gap-4">
				<a
					href="/#about"
					class="rounded-full bg-white px-6 py-3 text-sm font-medium text-black transition hover:bg-white/90 sm:px-7 sm:py-3.5 sm:text-base"
				>
					About Us
				</a>
				<a
					href="/#products"
					class="rounded-full border border-white/30 bg-white/5 px-6 py-3 text-sm font-medium text-white backdrop-blur-sm transition hover:bg-white/15 sm:px-7 sm:py-3.5 sm:text-base"
				>
					Explore Our Company
				</a>
			</div>
		</div>
	</div>
</section>
