---
import { products } from '../data/products.js';

const categories = ['All', 'Cooking', 'Sinks', 'Serving'];
---

<section
	id="products"
	class="scroll-mt-24 bg-white px-6 py-20 md:px-12 md:py-24"
	data-navbar-theme="light"
	data-nav-section="products"
>
	<!-- Heading -->
	<div class="mx-auto max-w-2xl text-center">
		<h2 class="text-4xl font-bold uppercase tracking-tight text-neutral-900 md:text-6xl">
			Our Products
		</h2>
		<p class="mx-auto mt-5 max-w-md text-lg leading-relaxed text-neutral-400">
			Precision-fabricated stainless steel equipment, built for the demands of professional kitchens.
		</p>
	</div>

	<!-- Filter pills -->
	<div class="mt-10 flex flex-wrap items-center justify-center gap-3">
		{
			categories.map((category, i) => (
				<button
					type="button"
					data-filter={category}
					class:list={[
						'rounded-full px-6 py-2.5 text-base font-medium transition',
						i === 0
							? 'bg-neutral-900 text-white'
							: 'border border-neutral-300 text-neutral-700 hover:border-neutral-900',
					]}
				>
					{category}
				</button>
			))
		}
		<span
			aria-hidden="true"
			class="flex h-11 w-11 items-center justify-center rounded-full border border-neutral-300 text-neutral-700"
		>
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="h-5 w-5">
				<path d="M4 6h10M18 6h2M4 12h2M10 12h10M4 18h8M16 18h4" stroke-linecap="round" />
				<circle cx="16" cy="6" r="2" />
				<circle cx="8" cy="12" r="2" />
				<circle cx="14" cy="18" r="2" />
			</svg>
		</span>
	</div>

	<!-- Product grid -->
	<div class="mt-14 grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-3 lg:grid-cols-4">
		{
			products.map((product) => (
				<article data-category={product.category} class="group flex flex-col">
					<a href={`/products/${product.slug}`} class="flex flex-col">
						<div class="overflow-hidden rounded-3xl bg-[#f4f4f4]">
							<div class="flex aspect-[4/5] items-center justify-center p-6">
								<img
									src={product.images[0]}
									alt={product.title}
									class="max-h-full max-w-full object-contain mix-blend-multiply transition-transform duration-300 group-hover:scale-[1.04]"
									loading="lazy"
								/>
							</div>
						</div>
						<h3 class="mt-5 text-xl font-bold tracking-tight text-neutral-900">
							{product.title}
						</h3>
						<p class="mt-1 text-base text-neutral-400">{product.description}</p>
						<p class="mt-3 text-xl font-bold text-neutral-900">{product.price}</p>
					</a>
				</article>
			))
		}
	</div>
</section>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
	const cards = document.querySelectorAll<HTMLElement>('[data-category]');

	buttons.forEach((btn) => {
		btn.addEventListener('click', () => {
			const filter = btn.dataset.filter;

			buttons.forEach((b) => {
				const active = b === btn;
				b.classList.toggle('bg-neutral-900', active);
				b.classList.toggle('text-white', active);
				b.classList.toggle('border', !active);
				b.classList.toggle('border-neutral-300', !active);
				b.classList.toggle('text-neutral-700', !active);
			});

			cards.forEach((card) => {
				const show = filter === 'All' || card.dataset.category === filter;
				card.style.display = show ? '' : 'none';
			});
		});
	});
</script>
