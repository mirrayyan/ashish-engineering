---
import { products } from '../data/products.js';

const categories = ['All', 'Cooking', 'Sinks', 'Serving'];
---

<section
	id="products"
	class="relative z-10 bg-white px-5 pb-16 pt-32 shadow-[0_-24px_60px_rgba(0,0,0,0.35)] sm:px-6 md:px-12 md:pb-24 md:pt-36"
	data-navbar-theme="light"
	data-nav-section="products"
>
	<!-- Heading -->
	<div class="mx-auto max-w-2xl text-center">
		<h2 class="text-4xl font-bold uppercase tracking-tight text-neutral-900 md:text-6xl">
			Our Products
		</h2>
		<p class="mx-auto mt-4 max-w-md text-base leading-snug text-neutral-400 md:text-lg">
			Precision-fabricated stainless steel equipment, built for the demands of professional kitchens.
		</p>
	</div>

	<!-- Filter pills: compact single row on phones -->
	<div class="mt-8 flex flex-wrap items-center justify-center gap-2 sm:mt-10 sm:gap-3">
		{
			categories.map((category, i) => (
				<button
					type="button"
					data-filter={category}
					class:list={[
						'rounded-full px-4 py-2 text-sm font-medium transition sm:px-6 sm:py-2.5 sm:text-base',
						i === 0
							? 'bg-neutral-900 text-white'
							: 'border border-neutral-300 text-neutral-700 hover:border-neutral-900',
					]}
				>
					{category}
				</button>
			))
		}
	</div>

	<!-- Product grid -->
	<div class="mt-8 grid grid-cols-1 gap-x-6 gap-y-12 sm:mt-14 sm:grid-cols-2 sm:gap-y-14 md:grid-cols-3 lg:grid-cols-4">
		{
			products.map((product) => (
				<article data-category={product.category} data-product-card={product.slug} class="group flex flex-col">
					<a href={`/products/${product.slug}`} class="flex flex-col">
						<div data-card-media class="overflow-hidden rounded-2xl bg-[#f4f4f4]">
							<div class="flex aspect-square items-center justify-center p-10 sm:aspect-[4/5] sm:p-8">
								<img
									src={product.images[0]}
									alt={product.title}
									class="max-h-full max-w-full object-contain mix-blend-multiply transition-transform duration-300 group-hover:scale-[1.04]"
									loading="lazy"
								/>
							</div>
						</div>
						<div class="mt-4 px-1">
							<h3 class="text-lg font-semibold leading-snug tracking-tight text-neutral-900 md:text-xl">
								{product.title}
							</h3>
							<p class="mt-1 text-sm leading-relaxed text-neutral-500">{product.description}</p>
						</div>
					</a>
				</article>
			))
		}
	</div>
</section>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
	const cards = document.querySelectorAll<HTMLElement>('[data-category]');

	buttons.forEach((btn) => {
		btn.addEventListener('click', () => {
			const filter = btn.dataset.filter;

			buttons.forEach((b) => {
				const active = b === btn;
				b.classList.toggle('bg-neutral-900', active);
				b.classList.toggle('text-white', active);
				b.classList.toggle('border', !active);
				b.classList.toggle('border-neutral-300', !active);
				b.classList.toggle('text-neutral-700', !active);
			});

			cards.forEach((card) => {
				const show = filter === 'All' || card.dataset.category === filter;
				card.style.display = show ? '' : 'none';
			});
		});
	});
</script>
