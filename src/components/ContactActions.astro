---
/**
 * The site's one contact CTA group, used everywhere a visitor might want to reach us:
 * WhatsApp (primary — async, and the enquiry text is pre-filled), Call (secondary),
 * and an optional quieter email link underneath.
 */
import ContactIcon from './ContactIcon.astro';
import { contact, telUrl, whatsappUrl, mailtoUrl } from '../data/contact.js';

interface Props {
	/** Background the group sits on. */
	tone?: 'light' | 'dark';
	size?: 'sm' | 'md' | 'lg';
	/** Adds the product to the pre-filled WhatsApp / email enquiry. */
	product?: { title: string; sku: string };
	email?: boolean;
	align?: 'start' | 'center';
	class?: string;
}

const { tone = 'light', size = 'md', product, email = false, align = 'start', class: className } = Astro.props;

const height = { sm: 'h-11 text-sm', md: 'h-12 text-sm', lg: 'h-14 text-base' }[size];
const primary =
	tone === 'dark' ? 'bg-white/95 text-black hover:bg-white' : 'bg-neutral-900 text-white hover:bg-neutral-800';
const secondary =
	tone === 'dark'
		? 'border border-white/30 text-white hover:border-white'
		: 'border border-neutral-300 text-neutral-900 hover:border-neutral-900';
const emailTone = tone === 'dark' ? 'text-white/60 hover:text-white' : 'text-neutral-500 hover:text-neutral-900';
---

<div class:list={['flex flex-col gap-3', align === 'center' && 'items-center', className]}>
	<div class="grid w-full grid-cols-2 gap-3">
		<a
			href={whatsappUrl(product)}
			target="_blank"
			rel="noopener noreferrer"
			class:list={['flex items-center justify-center gap-2 rounded-full px-5 font-semibold shadow-sm transition', height, primary]}
		>
			<ContactIcon name="whatsapp" class="h-[1.15em] w-[1.15em] text-[#25D366]" />
			WhatsApp
		</a>
		<a
			href={telUrl}
			class:list={['flex items-center justify-center gap-2 rounded-full px-5 font-semibold transition', height, secondary]}
		>
			<ContactIcon name="phone" class="h-[1.05em] w-[1.05em]" />
			Call Now
		</a>
	</div>
	{
		email && (
			<a
				href={mailtoUrl(product)}
				class:list={['inline-flex items-center gap-2 text-sm transition-colors', emailTone]}
			>
				<ContactIcon name="mail" class="h-4 w-4" />
				<span>
					or email <span class="underline decoration-current/30 underline-offset-4">{contact.email}</span>
				</span>
			</a>
		)
	}
</div>
